# Pins Go here because upstream's Nix build takes Go from nixpkgs, which can
# trail security releases. Keep the binary at /generic-device-plugin: the
# OpenHands chart passes only args and relies on this entrypoint.
FROM --platform=$BUILDPLATFORM golang:1.26.9 AS builder

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=unknown

WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -mod=vendor -trimpath \
      -ldflags "-s -w -X github.com/squat/generic-device-plugin/version.Version=${VERSION}" \
      -o /out/generic-device-plugin . \
 # Apache-2.0 §4(d) requires shipping the compiled-in dependencies' NOTICE files.
 && mkdir -p /out/licenses \
 && for f in $(find vendor -name NOTICE | sort); do \
      printf '==> %s <==\n' "$(dirname "${f#vendor/}")"; cat "$f"; printf '\n'; \
    done > /out/licenses/THIRD_PARTY_NOTICES

FROM scratch
ARG VERSION=unknown
LABEL org.opencontainers.image.source="https://github.com/OpenHands/generic-device-plugin" \
      org.opencontainers.image.description="Fork of squat/generic-device-plugin rebuilt with current Go and dependency security fixes" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}"
COPY LICENSE /licenses/LICENSE
COPY --from=builder /out/licenses/THIRD_PARTY_NOTICES /licenses/THIRD_PARTY_NOTICES
COPY --from=builder /out/generic-device-plugin /generic-device-plugin
ENTRYPOINT ["/generic-device-plugin"]
